# Browser-safe Supabase configuration. These values are public, but still environment-specific.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only configuration. Never prefix private values with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REDIRECT_URL=http://localhost:5173/reset-password

# Server-only communications providers. Never add these values to VITE_* variables.
SWIFTSMS_API_KEY=
SWIFTSMS_BASE_URL=
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
